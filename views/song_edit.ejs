<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>編集</title>
  <link rel="stylesheet" href="/public/song.css">
</head>
<body>
  <h2><%= data.title %> の編集</h2>
  <form action="/song/update/confirm/<%= index %>" method="POST">
    <label>曲名: <input type="text" name="title" value="<%= data.title %>"></label><br>
    <label>アーティスト名: <input type="text" name="artist" value="<%= data.artist %>"></label><br>
    <label>歌詞:<br><textarea name="lyrics" rows="5" cols="30"><%= data.lyrics %></textarea></label><br>
    <label>URL: <input type="text" name="url" value="<%= data.url %>"></label><br>
    <br>
    <input type="submit" value="確認画面へ">
  </form>
  <a href="/song/detail/<%= index %>">詳細に戻る</a>
</body>
</html>