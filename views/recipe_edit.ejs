<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>編集</title>
  <link rel="stylesheet" href="/public/recipe.css">
</head>
<body>
  <h2><%= data.name %> の編集</h2>
  <form action="/recipe/update/confirm/<%= index %>" method="POST">
    <label>料理名: <input type="text" name="name" value="<%= data.name %>"></label><br>
    <label>ジャンル: <input type="text" name="genre" value="<%= data.genre %>"></label><br>
    <label>材料:<br><textarea name="ingredients" rows="5" cols="30"><%= data.ingredients %></textarea></label><br>
    <label>作り方URL: <input type="text" name="url" value="<%= data.url %>"></label><br>
    <br>
    <input type="submit" value="確認画面へ">
  </form>
  <a href="/recipe/detail/<%= index %>">詳細に戻る</a>
</body>
</html>