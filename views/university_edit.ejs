<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>編集</title>
  <link rel="stylesheet" href="/public/university.css">
</head>
<body>
  <h2><%= data.name %> の編集</h2>
  <form action="/university/update/confirm/<%= index %>" method="POST">
    <label>大学名: <input type="text" name="name" value="<%= data.name %>"></label><br>
    <label>都道府県: <input type="text" name="prefecture" value="<%= data.prefecture %>"></label><br>
    <label>学部名:<br><textarea name="faculty" rows="5" cols="30"><%= data.faculty %></textarea></label><br>
    <label>URL: <input type="text" name="url" value="<%= data.url %>"></label><br>
    <br>
    <input type="submit" value="確認画面へ">
  </form>
  <a href="/university/detail/<%= index %>">詳細に戻る</a>
</body>
</html>