<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>大学追加</title>
</head>
<body>
    <h2>大学の追加</h2>
    <form action="/university/create/confirm" method="POST">
        <input type="text" name="name" required>
        <label for="name">大学名:</label><br>

        <input type="text" name="prefecture" required>
        <label for="prefecture">都道府県:</label><br>

        <textarea name="faculty" rows="5" cols="30"></textarea>
        <label for="faculty">学部名:</label><br>

        <input type="text" name="url">
        <label for="url">大学HPのURL:</label><br>
        
        <br>
        <input type="submit" value="確認画面へ">
    </form>
    <br>
    <a href="/university">一覧に戻る</a>
</body>
</html>