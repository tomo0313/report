<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>楽曲追加</title>
</head>
<body>
    <h2>楽曲の追加</h2>
    <form action="/song/create/confirm" method="POST">
        
        <input type="text" name="title" required>
        <label for="title">曲名:</label><br>

        <input type="text" name="artist" required>
        <label for="artist">アーティスト名:</label><br>

        <textarea name="lyrics" rows="5" cols="30"></textarea>
        <label for="lyrics">歌詞:</label><br>

        <input type="text" name="url">
        <label for="url">URL:</label><br>
        
        <br>
        <input type="submit" value="確認画面へ">
    </form>
    <br>
    <a href="/song">一覧に戻る</a>
</body>
</html>