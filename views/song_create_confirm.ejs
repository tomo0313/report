<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>追加確認</title>
    <link rel="stylesheet" href="/public/song.css">
</head>
<body>
    <h2>以下の内容で登録しますか？</h2>
    <ul>
        <li><strong>曲名:</strong> <%= data.title %></li>
        <li><strong>アーティスト名:</strong> <%= data.artist %></li>
        <li><strong>歌詞:</strong> <%= data.lyrics %></li>
        <li><strong>URL:</strong> <%= data.url %></li>
    </ul>

    <form action="/song/create/execute" method="POST">
        <input type="hidden" name="title" value="<%= data.title %>">
        <input type="hidden" name="artist" value="<%= data.artist %>">
        <input type="hidden" name="lyrics" value="<%= data.lyrics %>">
        <input type="hidden" name="url" value="<%= data.url %>">
        <input type="submit" value="登録">
    </form>
    <a href="/song/create">戻る</a>
</body>
</html>